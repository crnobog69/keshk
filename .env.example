# ---- Први налог (администратор; остали се додају преко позивног кода у Админ панелу) ----
KESHK_USERNAME=admin
KESHK_PASSWORD=промени-ме

# Насумичан дугачак стринг за потписивање сесије (нпр. 64 хекс карактера)
SESSION_SECRET=

# ---- Сервер ----
PORT=3000
# true када је иза HTTPS-а
COOKIE_SECURE=false

# ---- Neon Postgres база (попуњава `neon deploy` или Connect линк са Neon конзоле) ----
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production

# ---- Буџет ----
# Подразумевани износ Кешкића за брзо додавање у RSD
DEFAULT_KESHKIC=5000

# Резервни курсеви (RSD за 1 јединицу) ако курсна листа није доступна
FALLBACK_EUR_RSD=117.2
FALLBACK_USD_RSD=100

# ---- Пробни подаци ----
# true попуњава ПРАЗНУ базу пробним Кешкићима, трошковима и листама
KESHK_SEED=false
